# Callisto — Environment Configuration
# A product of AkashaVyom Labs | Connect Ideas. Design Systems.

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_VAPID_PUBLIC_KEY=
VITE_ENABLE_LOCAL_AI_FALLBACK=true
VITE_APP_NAME=Callisto
VITE_APP_ORG=AkashaVyom Labs

# Backend Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Tokens
JWT_SECRET_KEY=replace-with-a-64-char-cryptographically-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
TOKEN_ENCRYPTION_KEY=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=callisto_db

# Locale & Formatting Defaults
DEFAULT_COUNTRY=India
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_DATE_FORMAT=DD/MM/YYYY
DEFAULT_TIME_FORMAT=12h

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Callisto by AkashaVyom Labs
SMTP_USE_TLS=true

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@akashavyom.local

# AkashaVyom Labs Ecosystem Integration
SABHA_API_URL=
SABHA_API_KEY=
ECOSYSTEM_SHARED_AUTH=false

# Object Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Providers (Server-side only — never expose in frontend)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Rate Limiting & Import Guards
RATE_LIMIT_PER_MINUTE=120
MAX_IMPORT_BYTES=5242880
